{
  "name": "heridotlife",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.vite.jsonc astro dev",
    "dev:wrangler": "./setup_db.sh && pnpm build && wrangler dev",
    "dev:wrangler:skip-build": "./setup_db.sh && wrangler dev",
    "start": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.vite.jsonc astro dev",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.vite.jsonc node scripts/build-wrapper.mjs",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "validate": "./validate-deploy.sh",
    "logs": "wrangler tail heridotlife --format pretty",
    "logs:json": "wrangler tail heridotlife --format json",
    "logs:errors": "wrangler tail heridotlife --format pretty --status error",
    "astro": "astro",
    "db:migrate": "wrangler d1 execute D1_db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute D1_db --local --file=./schema.sql",
    "db:import": "wrangler d1 execute D1_db --local --file=./import_remote_data.sql",
    "db:setup": "pnpm db:migrate:local && pnpm db:import",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:local": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e:local",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "type-check": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=./wrangler.vite.jsonc astro check",
    "og:generate": "node scripts/generate-og-image.mjs",
    "og:convert": "node scripts/convert-og-to-jpeg.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/node": "^10.1.4",
    "@astrojs/react": "^6.0.0",
    "@cf-wasm/og": "^0.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.6",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.22.0",
    "pnpm": "^11.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.20",
    "@cloudflare/workers-types": "4.20260629.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "happy-dom": "^20.10.3",
    "jsdom": "^29.1.1",
    "miniflare": "4.20260625.0",
    "prettier": "^3.9.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "0.35.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
