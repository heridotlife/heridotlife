---
import Layout from '../../layouts/Layout.astro';
import { createCachedD1Helper } from '../../lib/cached-d1';
import { siteConfig } from '../../consts';
import type { KVNamespace } from '@cloudflare/workers-types';
import { env } from 'cloudflare:workers';

// Get query parameters for pagination and filtering
const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1');
const limit = parseInt(url.searchParams.get('limit') || '12');
const categorySlug = url.searchParams.get('category');
const tagSlug = url.searchParams.get('tag');
const query = (url.searchParams.get('q') || '').trim();
const isSearching = query.length > 0;

// Use cached D1 helper for better performance
const db = createCachedD1Helper(env.D1_db, env.heridotlife_kv as unknown as KVNamespace);

// In search mode, run a full-text search; otherwise list/filter published posts.
const searchResponse = isSearching ? await db.searchPosts({ q: query, page, limit }) : null;

const result = isSearching
  ? null
  : await db.getAllPublishedPosts({
      page,
      limit,
      categorySlug: categorySlug || undefined,
      tagSlug: tagSlug || undefined,
      sortBy: 'publishedAt',
      sortOrder: 'desc',
    });

const posts = result?.posts ?? [];
const pagination = searchResponse?.pagination ?? result?.pagination;

// Fetch all categories and tags for filters
const categories = await db.getAllBlogCategories();
const allTags = await db.getAllTags();

// Helper: build a pagination href that preserves the active query/filters.
const pageHref = (p: number) => {
  const params = new URLSearchParams();
  if (isSearching) params.set('q', query);
  if (categorySlug) params.set('category', categorySlug);
  if (tagSlug) params.set('tag', tagSlug);
  params.set('page', String(p));
  return `/blog?${params.toString()}`;
};

// Page metadata
const pageTitle = isSearching
  ? `Search: ${query} - Blog | ${siteConfig.title}`
  : categorySlug
    ? `${categorySlug} - Blog | ${siteConfig.title}`
    : tagSlug
      ? `#${tagSlug} - Blog | ${siteConfig.title}`
      : `Blog | ${siteConfig.title}`;

const pageDescription = isSearching
  ? `Search results for "${query}"`
  : categorySlug
    ? `Browse blog posts in ${categorySlug} category`
    : tagSlug
      ? `Browse blog posts tagged with ${tagSlug}`
      : 'Read our latest articles, tutorials, and insights';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-white text-slate-700 dark:bg-slate-950 dark:text-slate-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">
          {
            isSearching
              ? `Search: ${query}`
              : categorySlug
                ? categorySlug
                : tagSlug
                  ? `#${tagSlug}`
                  : 'Blog'
          }
        </h1>
        <p class="text-lg text-slate-500 dark:text-slate-400 max-w-2xl mx-auto">
          {pageDescription}
        </p>
      </div>

      <!-- Search -->
      <div class="mb-10 max-w-xl mx-auto">
        <form method="get" action="/blog" role="search" class="flex gap-2">
          <input
            type="search"
            name="q"
            value={query}
            placeholder="Search posts…"
            aria-label="Search blog posts"
            class="flex-1 px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500"
          />
          <button
            type="submit"
            class="px-5 py-3 rounded-lg bg-sky-600 text-white font-medium hover:bg-sky-700 transition-colors"
          >
            Search
          </button>
        </form>
        {
          isSearching && (
            <p class="mt-3 text-center text-sm text-slate-500 dark:text-slate-400">
              {searchResponse?.total ?? 0} result{(searchResponse?.total ?? 0) === 1 ? '' : 's'} for
              <span class="font-semibold">“{query}”</span> ·{' '}
              <a class="underline" href="/blog">
                Clear
              </a>
            </p>
          )
        }
      </div>

      <!-- Filters (browse mode only) -->
      {
        !isSearching && (
          <div class="mb-8 space-y-4">
            {/* Categories */}
            <div class="flex flex-wrap gap-2 justify-center items-center">
              <span class="text-sm font-semibold text-slate-600 dark:text-slate-400 mr-2">
                Categories:
              </span>
              <a
                href="/blog"
                class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                  !categorySlug && !tagSlug
                    ? 'bg-sky-600 text-white'
                    : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700'
                }`}
              >
                All Posts
              </a>
              {categories.slice(0, 5).map((category) => (
                <a
                  href={`/blog?category=${category.slug}`}
                  class={`px-4 py-2 rounded-lg font-medium transition-colors ${
                    categorySlug === category.slug
                      ? 'bg-sky-600 text-white'
                      : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700'
                  }`}
                >
                  {category.name}
                </a>
              ))}
            </div>

            {/* Tags */}
            {allTags.length > 0 && (
              <div class="flex flex-wrap gap-2 justify-center items-center">
                <span class="text-sm font-semibold text-slate-600 dark:text-slate-400 mr-2">
                  Tags:
                </span>
                {allTags.slice(0, 10).map((tag) => (
                  <a
                    href={`/blog?tag=${tag.slug}`}
                    class={`px-3 py-1 text-sm rounded-full font-medium transition-colors ${
                      tagSlug === tag.slug
                        ? 'bg-cyan-600 text-white'
                        : 'bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700'
                    }`}
                  >
                    #{tag.name}
                  </a>
                ))}
              </div>
            )}
          </div>
        )
      }

      <!-- Search results (search mode) -->
      {
        isSearching &&
          (searchResponse && searchResponse.results.length > 0 ? (
            <div class="space-y-6 mb-12 max-w-3xl mx-auto">
              {searchResponse.results.map((r) => (
                <article class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 hover:shadow-md transition-shadow">
                  {r.categories && r.categories.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-2">
                      {r.categories.map((category) => (
                        <a
                          href={`/blog?category=${category.slug}`}
                          class="px-2 py-1 text-xs font-medium rounded-full bg-sky-100 dark:bg-sky-900 text-sky-700 dark:text-sky-300 hover:bg-sky-200 dark:hover:bg-sky-800"
                        >
                          {category.name}
                        </a>
                      ))}
                    </div>
                  )}
                  <a href={`/blog/${r.slug}`}>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                      {r.title}
                    </h2>
                  </a>
                  <p
                    class="text-slate-600 dark:text-slate-300"
                    set:html={r.highlightedSnippet || r.excerpt}
                  />
                  <div class="mt-3 text-sm">
                    <a
                      class="font-medium text-sky-600 dark:text-sky-400 hover:underline"
                      href={`/blog/${r.slug}`}
                    >
                      Read more →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="text-center py-16">
              <div class="text-6xl mb-4">🔍</div>
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">No results</h2>
              <p class="text-slate-500 dark:text-slate-400">
                Nothing matched “{query}”. Try different keywords.
              </p>
            </div>
          ))
      }

      <!-- Blog Posts Grid (browse mode) -->
      {
        !isSearching &&
          (posts.length === 0 ? (
            <div class="text-center py-16">
              <div class="text-6xl mb-4">📝</div>
              <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">No posts found</h2>
              <p class="text-slate-500 dark:text-slate-400">
                {categorySlug || tagSlug
                  ? 'Try removing filters to see all posts'
                  : 'Check back soon for new content!'}
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
              {posts.map((post) => (
                <article class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden hover:shadow-md transition-shadow">
                  {post.featuredImage && (
                    <a href={`/blog/${post.slug}`} class="block">
                      <img
                        src={post.featuredImage}
                        alt={post.featuredImageAlt || post.title}
                        class="w-full h-48 object-cover"
                      />
                    </a>
                  )}

                  <div class="p-6">
                    {post.categories && post.categories.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-3">
                        {post.categories.map((category) => (
                          <a
                            href={`/blog?category=${category.slug}`}
                            class="px-2 py-1 text-xs font-medium rounded-full bg-sky-100 dark:bg-sky-900 text-sky-700 dark:text-sky-300 hover:bg-sky-200 dark:hover:bg-sky-800"
                            style={category.color ? `borderLeft: 3px solid ${category.color}` : ''}
                          >
                            {category.name}
                          </a>
                        ))}
                      </div>
                    )}

                    <a href={`/blog/${post.slug}`}>
                      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 hover:text-sky-600 dark:hover:text-sky-400 transition-colors">
                        {post.title}
                      </h2>
                    </a>

                    <p class="text-slate-600 dark:text-slate-300 mb-4 line-clamp-3">
                      {post.excerpt}
                    </p>

                    {post.tags && post.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mb-4">
                        {post.tags.slice(0, 3).map((tag) => (
                          <a
                            href={`/blog?tag=${tag.slug}`}
                            class="px-2 py-1 text-xs font-medium text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300"
                          >
                            #{tag.name}
                          </a>
                        ))}
                      </div>
                    )}

                    <div class="flex items-center justify-between text-sm text-slate-500 dark:text-slate-400">
                      <div class="flex items-center gap-4">
                        {post.readTime && <span>📖 {post.readTime} min read</span>}
                        {post.viewCount > 0 && <span>👁️ {post.viewCount} views</span>}
                      </div>
                      <time
                        datetime={
                          post.publishedAt ? new Date(post.publishedAt * 1000).toISOString() : ''
                        }
                      >
                        {post.publishedAt
                          ? new Date(post.publishedAt * 1000).toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                            })
                          : 'Not published'}
                      </time>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ))
      }

      <!-- Pagination -->
      {
        pagination && pagination.totalPages > 1 && (
          <div class="flex justify-center items-center gap-2">
            {pagination.hasPrev && (
              <a
                href={pageHref(page - 1)}
                class="px-4 py-2 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
              >
                ← Previous
              </a>
            )}

            <span class="px-4 py-2 text-slate-600 dark:text-slate-400">
              Page {pagination.page} of {pagination.totalPages}
            </span>

            {pagination.hasNext && (
              <a
                href={pageHref(page + 1)}
                class="px-4 py-2 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
              >
                Next →
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
