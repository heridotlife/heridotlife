---
import URLForm from '../../../components/admin/URLForm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="New URL">
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Create New Short URL</h1>
      <p class="text-sky-600 dark:text-sky-400 mt-2">Add a new short URL to your collection</p>
    </div>

    <div
      class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-6"
    >
      <URLForm client:load />
    </div>
  </div>
</AdminLayout>
